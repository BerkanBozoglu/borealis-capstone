{
  "name": "borealis-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BOREALIS systems dashboard: static site generated from data/*.yaml",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "lint": "tsx scripts/lint-data.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "diff-register": "tsx scripts/diff-register.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  }
}
